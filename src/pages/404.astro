---
// Fundation
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard">
      <div
        class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b py-8 py-24 border-base-200 dark:border-base-800"
      >
        <div>
          <Text
            tag="h1"
            variant="textSM"
            class="font-medium text-base-900 dark:text-white"
          >
            404 — Not Found</Text
          >
          <Text
            tag="p"
            variant="textXS"
            class="text-base-600 dark:text-base-600 dark:text-base-400"
          >
            You wandered too far.
          </Text>
        </div>
        <div class="lg:col-span-2 flex flex-col">
          <div class="space-y-6">
            <div>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-400"
              >
                "All I know is that this page does not exist."
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-500 dark:text-base-500 ml-4 mt-1"
              >
                – Socrates, if he had browsed the internet
              </Text>
            </div>
            
            <div>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-400"
              >
                "When you don't find what you're looking for, maybe you're meant to find something else."
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-500 dark:text-base-500 ml-4 mt-1"
              >
                – Carl Jung (inspired)
              </Text>
            </div>
            
            <div>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-400"
              >
                "You are lost not because there is no path, but because you were looking for the wrong one."
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-500 dark:text-base-500 ml-4 mt-1"
              >
                – Friedrich Nietzsche (loosely inspired)
              </Text>
            </div>
            
            <div>
              <Text
                tag="p"
                variant="textSM"
                class="text-base-600 dark:text-base-400"
              >
                "You were looking for something. Instead, you found nothing. Welcome to existence."
              </Text>
              <Text
                tag="p"
                variant="textXS"
                class="text-base-500 dark:text-base-500 ml-4 mt-1"
              >
                – Inspired by Jean-Paul Sartre
              </Text>
            </div>
          </div>
          <div class="flex mt-2">
            <Button isLink={true} href="/" size="xs" variant="muted">
              Go back home
            </Button>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
