---

// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const data = [
  {
    period: "February 2026 – Present",
    title: "Avansig",
    description: `Currently working at Avansig, a software development company specializing in web applications and Geographic Information Systems. In this role, I am responsible for developing software solutions that meet the needs of our clients.`,
    location: "Vigo, Spain",
    link: "#_",
  },
  // {
  //   period: "July 2022 – August 2022",
  //   title: "Anfitriona",
  //   description: `Worked for a company that manages vacation rental apartments on Airbnb. In a customer-facing role, I provided support and assistance to address any questions that may arise.`,
  //   location: "Vigo, Spain",
  //   link: "#_",
  // },
];
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b py-8 border-base-200 dark:border-base-800"
    >
      <div class="lg:sticky lg:top-24 lg:z-40 self-start">
        <Text tag="h2" variant="textSM" class="text-base-900 dark:text-white">
          Work
        </Text>
      </div>
      <div class="relative flex flex-col gap-12 pl-6 lg:col-span-2">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute bottom-2 left-1 top-2 w-px bg-base-300 dark:bg-base-700"
        />
        {
          data.map((work) => (
            <article class="group relative grid grid-cols-1 gap-4 lg:grid-cols-3 lg:items-start ">
              <div class="relative lg:col-span-2">
                <span
                  aria-hidden="true"
                  class="absolute -left-6 top-[0.3rem] z-20 size-2 rounded-full bg-accent-500 dark:bg-accent-400"
                />
                
                <Text
                  tag="h3"
                  variant="textSM"
                  class=" font-medium tracking-tight text-base-900 dark:text-white    "
                >
                  <div class="absolute -inset-x-1 -inset-y-4 z-0 scale-95 bg-base-50 dark:bg-base-800/20    opacity-0 transition group-hover:scale-100 group-hover:opacity-100 rounded-2xl duration-300" />
                  <a href={work.link}>
                    <>
                      <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                      <span class="relative z-10"> {work.title}</span>
                    </>
                  </a>
                </Text>
                <Text
                  tag="p"
                  variant="textXS"
                  class="relative z-10 mt-1 text-base-600 dark:text-base-450      "
                >
                  {work.description}
                </Text>
              </div>
              <Text
                tag="p"
                variant="textXS"
                class="relative z-10   flex items-center text-sm text-base-600 dark:text-base-400  lg:ml-auto"
              >
                <time datetime={work.period}> {work.period}</time>
              </Text>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
