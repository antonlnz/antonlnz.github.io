---
// Assets
import { Image } from "astro:assets";
import Iter from "@/images/icons/iter.svg";
import Lexora from "@/images/icons/lexora.svg";
import Java from "@/images/icons/java.svg";
import Retriever from "@/images/icons/retriever.svg";
import C from "@/images/icons/c.svg";
import SpainTimes from "@/images/icons/spain-times.svg";

// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
const data = [
  {
    year: "2025",
    title: "Search Chatbot for iter.org - Bachelor's Thesis",
    image: Iter,
    link: "https://github.com/antonlnz/iter-multi-model-search-chatbot",
    description: `Developed an intelligent chatbot for the ITER website powered by GraphRAG (Graph-enhanced Retrieval-Augmented Generation). It leverages ITER's official website content to deliver accurate, verifiable and context-aware answers about the ITER project and nuclear fusion energy. Built on a microservices architecture using Docker, a vector database, an LLM and support services.`,
  },
  {
    year: "2026",
    title: "Retriever",
    image: Retriever,
    link: "https://getretriever.app",
    description: `Designed and built a Mac app that finds any moment in your own footage from a plain-language description and returns the clip and the exact second. It indexes video, photos and audio entirely on-device, fusing what's seen, what's said, on-screen text, sounds, faces and voices into a single ranking, and sends the moment straight to Final Cut Pro, DaVinci Resolve or Premiere Pro. Rust from the indexing pipeline to the licensing backend, with local ML models, an encrypted index and a Svelte interface on Tauri.`,
  },
  {
    year: "2026",
    title: "Online newspaper inspired in The New York Times",
    image: SpainTimes,
    link: "https://news.antonlnz.com",
    description: `Created an online newspaper inspired by The New York Times. Built with SvelteKit, it offers a responsive design and a user-friendly interface for an optimal reading experience across devices.`,   
    invertInDark: true,
  },
  {
    year: "2025",
    title: "Lexora: A hub for digital content",
    image: Lexora,
    link: "https://github.com/antonlnz/lexora",
    description: `Developed a digital content centralisation platform. From RSS feeds (news, newsletters) to social networks such as Instagram, Tiktok or X. The goal is to have a platform in which to consume only the content you want, without infinite scrolls or algorithms. It was built with Next.js`,
  },
  {
    year: "2023-2024",
    link: "https://github.com/antonlnz/ticket-sales-platform",
    image: Java,
    title: "Ticket sales platform for a sports club",
    description: `REST application that manages the sales system for a Sports Club. Follows a layered architecture (Data Access Layer, Business Logic Layer, Services Layer, Service Access Layer and User Interface Layer).`,
    invertInDark: true,
  },
  {
    year: "2023-2024",
    title: "C SHEL",
    image: C,
    link: "https://github.com/antonlnz/SO-shell",
    description: `The program consists of a shell similar to what bash and zsh do, with some functions and also the ability to run any other command on the *nix system.`,
    invertInDark: true,
  },
];
---

<section>
  <Wrapper variant="standard">
    <div
      class="grid grid-cols-1 gap-4 md:grid-cols-3 border-b py-8 border-base-200 dark:border-base-800"
    >
      <div class="lg:sticky lg:top-24 lg:z-40 self-start">
        <Text tag="h2" variant="textSM" class="text-base-900 dark:text-white">
          Projects
        </Text>
      </div>
      <div class="lg:col-span-2 flex flex-col gap-8">
        {
          data.map((project) => (
            <article class="group relative grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start lg:gap-6">
                 <div class="absolute -inset-x-1 -inset-y-4 z-0 scale-95 bg-base-50 dark:bg-base-800/20 opacity-0 transition group-hover:scale-100 group-hover:opacity-100 -inset-x-4 rounded-2xl duration-300 " />
              <div class="min-w-0">
               <div class="flex items-center gap-4 relative">
                  <Image
                    src={project.image}
                    alt={project.title}
                    width={400}
                    height={400}
                    loading="eager"
                    decoding="async"
                    class={`rounded-lg size-12 object-cover object-center relative ${project.invertInDark ? 'dark:invert dark:brightness-90' : ''}`}
                  />
                  <div>
                    <Text
                      tag="h3"
                      variant="textSM"
                      class=" font-medium tracking-tight text-base-900 dark:text-white  "
                    >
                      <a href={project.link}>
                        <>
                          <span class="absolute -inset-x-4 -inset-y-6 z-20 sm:-inset-x-6 sm:rounded-2xl" />
                          <span class="relative z-10"> {project.title}</span>
                        </>
                      </a>
                    </Text>
                    <Text
                      tag="p"
                      variant="textXS"
                      class="relative z-10 mt-1 text-base-500 dark:text-base-500 lg:hidden"
                    >
                      <time datetime={project.year}> {project.year}</time>
                    </Text>
                  <Text
                    tag="p"
                    variant="textXS"
                    class="relative z-10 text-base-600 dark:text-base-450      "
                  >
                    {project.description}
                  </Text>
                  </div>
               </div>
              </div>
              <Text
                tag="p"
                variant="textXS"
                class="relative z-10 hidden lg:flex items-center text-sm text-base-600 dark:text-base-400 lg:self-start whitespace-nowrap"
              >
                <time datetime={project.year}> {project.year}</time>
              </Text>
            </article>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
