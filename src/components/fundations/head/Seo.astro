---
import { AstroSeo } from "@astrolib/seo";

const title = "Antón's Portfolio";
const description = "Portfolio Antón López - Fullstack Developer";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title,
    description,
    site_name: title,
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@antonlnz",
    site: "@antonlnz",
    cardType: "summary",
  }}
/>
