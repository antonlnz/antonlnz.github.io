<script is:inline>
  // Función para actualizar el theme-color según el tema
  function updateThemeColor(isDark) {
    const themeColorMeta = document.querySelector('meta[name="theme-color"]');
    if (themeColorMeta) {
      // Cambia el color según el tema
      themeColorMeta.setAttribute('content', isDark ? 'rgb(23, 23, 23)' : 'rgb(251, 251, 251)');
    }
  }

  const theme = (() => {
    // First, check localStorage
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    // If no saved preference, use system preference
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  // Apply initial theme
  if (theme === "light") {
    document.documentElement.classList.remove("dark");
    updateThemeColor(false);
  } else {
    document.documentElement.classList.add("dark");
    updateThemeColor(true);
  }

  // Save to localStorage only if user changed it manually
  window.localStorage.setItem("theme", theme);

  // Listener for system mode changes
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
    const manualOverride = localStorage.getItem("theme-manual-override");
    
    if (!manualOverride) {
      const newTheme = e.matches ? "dark" : "light";
      if (newTheme === "dark") {
        document.documentElement.classList.add("dark");
        updateThemeColor(true);
      } else {
        document.documentElement.classList.remove("dark");
        updateThemeColor(false);
      }
      window.localStorage.setItem("theme", newTheme);
    }
  });

  // Handle toggle button click
  document.addEventListener("astro:page-load", () => {
    const handleToggleClick = () => {
      const element = document.documentElement;
      element.classList.toggle("dark");

      const isDark = element.classList.contains("dark");
      updateThemeColor(isDark);
      localStorage.setItem("theme", isDark ? "dark" : "light");
      localStorage.setItem("theme-manual-override", "true");
    };

    document
      .getElementById("themeToggle")
      ?.addEventListener("click", handleToggleClick);
  });
</script>